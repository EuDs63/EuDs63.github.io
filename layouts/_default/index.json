{{- $index := slice -}}{{- range site.RegularPages -}}{{- if and (not .Params.searchHidden) (not .Params.hidden) (ne .Layout "archives") (ne .Layout "search") -}}{{- $index = $index | append (dict "title" .Title "content" .Plain "permalink" .Permalink "summary" (.Summary | plainify | htmlUnescape | truncate 170) "date" (.Date.Format "2006.01.02") "categories" (.Params.categories | default slice) "tags" (.Params.tags | default slice)) -}}{{- end -}}{{- end -}}{{- $index | jsonify -}}